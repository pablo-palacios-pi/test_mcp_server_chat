# Imagen base
FROM python:3.11-slim

# Directorio de trabajo dentro del contenedor
WORKDIR /app

# Copiar requirements.txt del root compartido
COPY ./shared/requirements.txt ./requirements.txt

# Instalar dependencias
RUN pip install --no-cache-dir -r requirements.txt

# Copiar el código fuente de cada agente en runtime (usado con volumes)
COPY . .

# Exponer un puerto (puede ser sobrescrito por cada agente en docker-compose)
EXPOSE 8000

# Comando por defecto (sobrescrito en cada servicio)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
